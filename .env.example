# --- Required in production -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=your-app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# --- Local development ------------------------------------------------------------------------
# DJANGO_DEBUG=1

# --- Infrastructure (optional) ------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0      # shared cache + throttling; falls back to in-memory
# NUM_PROXIES=1                           # reverse proxies in front of the app (client IP)
# DJANGO_SSL_REDIRECT=1
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# LOG_LEVEL=INFO

# --- External providers (defaults are free, keyless public endpoints) -----------------------
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# VALHALLA_MAX_MI=900                     # public server rejects > 1,500 km straight-line
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=                     # commercial key for higher rate limits
# PHOTON_URL=https://photon.komoot.io/api/
# HTTP_TIMEOUT_S=20

# --- Domain tuning --------------------------------------------------------------------------
# TRUCK_TARE_LB=35000                     # tractor + empty trailer, added to load for routing
# TRUCK_MAX_MPH=65                        # speed governor applied to ETAs
# HEATMAP_MAX_CELLS=250
# THROTTLE_PLAN=20/min
# THROTTLE_GEOCODE=90/min
